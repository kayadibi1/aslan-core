# aslan-core / Hetzner deploy — example env file.
#
# Copy to `.env` (in this directory) before `docker compose up`.
# Real .env is git-ignored. Never commit secrets to this file.

# ---- core platform ----
ASLAN_JWT_SECRET=
ASLAN_INVITE_CODE=
ASLAN_PG_DSN=postgresql+asyncpg://aslan:aslan@postgres:5432/aslan
ASLAN_DASHBOARD_DSN=postgresql+asyncpg://aslan_dashboard:aslan_dashboard@postgres:5432/aslan
ASLAN_DASHBOARD_PASSWORD=aslan_dashboard
ASLAN_REDIS_URL=redis://redis:6379/0

# ---- pullers ----
EVDS_API_KEY=

# KAP Velhamdulillah API (production scraper bypass channel)
KAP_VYK_API_KEY=
KAP_VYK_API_SECRET=

# Webshare proxy (KAP body-fetcher + opt-in dq HTTP probes)
KAP_PROXY_URL=

# ---- dq subsystem (M3 alerting + opt-in HTTP probes) ----

# Public-status page DSN — must point at the dedicated
# public_status_reader role created in migration 0063.
# Format: postgresql://public_status_reader:<password>@postgres:5432/aslan
ASLAN_PUBLIC_STATUS_DSN=

# GlitchTip DSN (already running on Hetzner :8800; create a project
# there + paste the DSN). Empty = sink suppressed.
DQ_GLITCHTIP_DSN=

# SMTP relay for alert digest. Format: smtp://user:pass@host:port (or smtps://).
# Examples:
#   smtps://api:RESEND_API_KEY@smtp.resend.com:465
#   smtp://AKIA...:SECRET@email-smtp.us-east-1.amazonaws.com:587
DQ_ALERT_SMTP_URL=
DQ_ALERT_FROM=alerts@aslan.terminal
DQ_ALERT_TO=sidar@aslan.terminal

# Slack incoming webhook URL for high-severity alerts.
# Create at https://api.slack.com/apps -> Incoming Webhooks -> "#aslan-alerts"
DQ_SLACK_WEBHOOK_URL=

# Opt-in upstream probes. Default unset = DB-only probes (safe,
# no external traffic). Setting these enables HTTP probes that
# route through KAP_PROXY_URL (Webshare).
DQ_KAP_LISTING_URL=
DQ_MKK_API_URL=
DQ_MKK_API_KEY=

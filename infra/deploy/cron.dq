# dq subsystem cron — append to user emersus's crontab on Hetzner.
#
# Install:
#   crontab -l | grep -v '^# dq subsystem cron' | grep -v 'aslan audit' \
#     > /tmp/crontab.before
#   cat /tmp/crontab.before infra/deploy/cron.dq | crontab -
#
# All entries follow the workspace's existing cron convention (see
# HETZNER_OPS.md):
#   cd ~/aslan-core/infra/deploy && docker compose run --rm \
#     --entrypoint /app/.venv/bin/aslan dashboard audit <subcommand>
#
# Logs land under /home/emersus/aslan-core/infra/deploy/dq-*.log so they
# co-locate with scraper.log / disclosures.log etc.

# Recency sweep — every 5 min
*/5 * * * * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit recency-sweep >> /home/emersus/aslan-core/infra/deploy/dq-recency.log 2>&1

# Coverage snapshot — hourly
0 * * * * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit coverage-snapshot >> /home/emersus/aslan-core/infra/deploy/dq-coverage.log 2>&1

# Cross-source consistency — nightly 02:00 UTC
0 2 * * * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit cross-source-consistency >> /home/emersus/aslan-core/infra/deploy/dq-xs.log 2>&1

# Regression detect (v1+v2) — nightly 03:00 UTC
0 3 * * * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit regression-detect >> /home/emersus/aslan-core/infra/deploy/dq-regr.log 2>&1

# Bloomberg auto-sample — nightly 04:00 UTC (only writes when an open run exists)
0 4 * * * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit bloomberg-sample >> /home/emersus/aslan-core/infra/deploy/dq-bloomberg-sample.log 2>&1

# Spot-check draw — Mon 06:00 UTC
0 6 * * 1 cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit spot-check-draw >> /home/emersus/aslan-core/infra/deploy/dq-spot-check.log 2>&1

# Weekly scorecard — Sun 23:55 UTC
55 23 * * 0 cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit scorecard >> /home/emersus/aslan-core/infra/deploy/dq-scorecard.log 2>&1

# Bloomberg quarterly open + reminder — 09:00 UTC on 1st of Jan/Apr/Jul/Oct
0 9 1 1,4,7,10 * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit bloomberg-open-quarter && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit bloomberg-reminder >> /home/emersus/aslan-core/infra/deploy/dq-bloomberg-open.log 2>&1

# Bloomberg quarterly close — 09:00 UTC on 28th of Mar/Jun/Sep/Dec (approximated; harmless if it fires once outside the window since close-quarter is idempotent on already-closed)
0 9 28 3,6,9,12 * cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit bloomberg-close-quarter --quarter "$(date -u +\%Y)Q$(((($(date -u +\%-m)+2)/3)))" >> /home/emersus/aslan-core/infra/deploy/dq-bloomberg-close.log 2>&1

# Bloomberg weekly reminder — Mon 09:00 UTC during open quarter
0 9 * * 1 cd /home/emersus/aslan-core/infra/deploy && docker compose run --rm --entrypoint /app/.venv/bin/aslan dashboard audit bloomberg-reminder >> /home/emersus/aslan-core/infra/deploy/dq-bloomberg-reminder.log 2>&1
